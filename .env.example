# Copy to .env.local and fill in values. Never commit real secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google OAuth credentials are configured in Supabase Auth. These optional
# server-only values are for local reference and are not used by the app.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
